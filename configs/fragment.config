# Merged on top of Fedora rawhide's x86_64 kernel config by
# scripts/build-kernel.sh. Symbols unknown to a given kernel version are
# ignored.

# No external signing certificates; modules are signed with a per-build
# autogenerated key.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# No debug info: cuts build time and package size, avoids a huge -dbg
# package. Also disables BTF, so pahole is not needed.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set

# New compiler warnings on older LTS trees must not fail the build.
# CONFIG_WERROR is not set
